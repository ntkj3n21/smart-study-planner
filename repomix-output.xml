// 4. XÓA MÔN HỌC
exports.deleteSubject = async (req, res, next) => {
  try {
    const { id } = req.params;

    // Dùng deleteMany để kết hợp điều kiện: Chỉ xóa môn học CỦA ĐÚNG USER ĐÓ
    const deletedSubject = await prisma.subject.deleteMany({
